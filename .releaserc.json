{
  "branches": ["main"],
  "tagFormat": "${version}",
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    "@semantic-release/changelog",
    ["@semantic-release/exec", {
      "prepareCmd": "python3 scripts/bump_version.py ${nextRelease.version} && zip -r jourferier.zip custom_components/jourferier"
    }],
    ["@semantic-release/git", {
      "assets": [
        "custom_components/jourferier/manifest.json",
        "custom_components/jourferier/const.py",
        "README.md",
        "CHANGELOG.md"
      ],
      "message": "chore(release): ${nextRelease.version} [skip ci]\n\n${nextRelease.notes}"
    }],
    ["@semantic-release/github", {
      "assets": [
        {"path": "jourferier.zip", "label": "jourferier.zip"}
      ]
    }]
  ]
}
